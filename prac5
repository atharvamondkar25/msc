import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

data = {
    "CustomerID": [1, 2, 3, 4, 5, 6, 7, 8],
    "Age": [25, 30, np.nan, 40, 29, 33, np.nan, 120],
    "Salary": [50000, 60000, 55000, np.nan, 52000, 58000, np.nan, 400000],
    "City": ["Mumbai", "Delhi", np.nan, "Chennai", "Delhi", "Mumbai", "Chennai", "Delhi"]
}
df = pd.DataFrame(data)
print("Original Dataset:\\n", df)
print("\\nMissing values:\\n", df.isnull().sum())

sns.heatmap(df.isnull(), cbar=False, cmap="viridis")
plt.title("Missing Values Heatmap")
plt.show()

df["Age"] = df["Age"].fillna(df["Age"].median())
df["Salary"] = df["Salary"].fillna(df["Salary"].mean())
df["City"] = df["City"].fillna(df["City"].mode()[0])
print("\\nDataset After Fixing Missing Values:\\n", df)

plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
sns.boxplot(y=df["Age"])
plt.title("Age Outliers")
plt.subplot(1, 2, 2)
sns.boxplot(y=df["Salary"])
plt.title("Salary Outliers")
plt.show()

Q1 = df[["Age", "Salary"]].quantile(0.25)
Q3 = df[["Age", "Salary"]].quantile(0.75)
IQR = Q3 - Q1
outliers = ((df[["Age", "Salary"]] < (Q1 - 1.5 * IQR)) |
            (df[["Age", "Salary"]] > (Q3 + 1.5 * IQR)))
print("\\nOutlier flags:\\n", outliers)
print("\\nRows containing outliers:\\n", df[outliers.any(axis=1)])
