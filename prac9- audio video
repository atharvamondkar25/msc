import cv2
import numpy as np

MODEL = "yolov4.weights"
CONFIG = "yolov4.cfg"
CLASSES_FILE = "coco.names"
INPUT = "input.jpg"
CONFIDENCE_THRESHOLD = 0.5
NMS_THRESHOLD = 0.4

with open(CLASSES_FILE, "r") as f:
    classes = [line.strip() for line in f.readlines()]
    
net = cv2.dnn.readNet(MODEL, CONFIG)
layer_names = net.getLayerNames()
output_layers = [layer_names[i - 1] for i in net.getUnconnectedOutLayers()]

def detect_objects(frame):
    height, width = frame.shape[:2]
    blob = cv2.dnn.blobFromImage(
        frame,
        1 / 255.0,
        (416, 416),
        swapRB=True,
        crop=False
    )
    
    net.setInput(blob)
    outputs = net.forward(output_layers)
    boxes = []
    confidences = []
    class_ids = []
    
    for output in outputs:
        for detection in output:
            scores = detection[5:]
            class_id = np.argmax(scores)
            confidence = scores[class_id] * detection[4]
            
            if confidence > CONFIDENCE_THRESHOLD:
                center_x = int(detection[0] * width)
                center_y = int(detection[1] * height)
                box_width = int(detection[2] * width)
                box_height = int(detection[3] * height)
                
                x = int(center_x - box_width / 2)
                y = int(center_y - box_height / 2)
                
                boxes.append((x, y, box_width, box_height))
                confidences.append(float(confidence))
                class_ids.append(class_id)
                
    indexes = cv2.dnn.NMSBoxes(
        boxes,
        confidences,
        CONFIDENCE_THRESHOLD,
        NMS_THRESHOLD
    )
    
    for i in indexes:
        i = int(i)
        x, y, w, h = boxes[i]
        label = f"{classes[class_ids[i]]}: {confidences[i]:.2f}"
        
        cv2.rectangle(
            frame,
            (x, y),
            (x + w, y + h),
            (0, 255, 0),
            2
        )
        cv2.putText(
            frame,
            label,
            (x, max(y - 10, 20)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            (0, 255, 0),
            2
        )
    return frame

if isinstance(INPUT, str) and INPUT.lower().endswith(
    (".jpg", ".jpeg", ".png", ".bmp")
):
    frame = cv2.imread(INPUT)
    if frame is None:
        print("Error: Could not open image.")
    else:
        result = detect_objects(frame)
        cv2.imshow("Object Detection", result)
        cv2.imwrite("output.jpg", result)
        print("Detection completed. Output saved as output.jpg")
        cv2.waitKey(0)
        cv2.destroyAllWindows()
else:
    cap = cv2.VideoCapture(INPUT)
    if not cap.isOpened():
        print("Error: Could not open video/webcam.")
    else:
        while True:
            ret, frame = cap.read()
            if not ret:
                break
                
            result = detect_objects(frame)
            cv2.imshow("Object Detection", result)
            
            if cv2.waitKey(1) & 0xFF == ord("q"):
                break
                
        cap.release()
        cv2.destroyAllWindows()
